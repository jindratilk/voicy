{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voicy",
  "version": "0.3.2",
  "identifier": "com.voicy.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; media-src http://127.0.0.1:* blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "shortDescription": "Local speech enhancement",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/dist/": "web/",
      "../build/runtime/": "runtime/"
    },
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "mp3",
          "m4a",
          "flac",
          "aiff",
          "ogg"
        ],
        "name": "Audio recording",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
